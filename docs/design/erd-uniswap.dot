graph UniSwap {
  // Render with neato -Tsvg erd-uniswap.dot -o erd-uniswap.svg
  graph [overlap=prism, sep="+19", splines=true, start=24, bgcolor="white", pad=.35];
  node [fontname="DejaVu Sans",fontsize=13];
  edge [fontname="DejaVu Sans",fontsize=11,len=1.8,labeldistance=1.8];
  User [shape=box,style=bold];
  User_id [shape=ellipse,label=<<U>id</U>>];
  User -- User_id [len=.85];
  User_displayName [shape=ellipse,label=<displayName>];
  User -- User_displayName [len=.85];
  User_email [shape=ellipse,label=<email>];
  User -- User_email [len=.85];
  School [shape=box,style=bold];
  School_id [shape=ellipse,label=<<U>id</U>>];
  School -- School_id [len=.85];
  School_name [shape=ellipse,label=<name>];
  School -- School_name [len=.85];
  School_code [shape=ellipse,label=<code>];
  School -- School_code [len=.85];
  Listing [shape=box,style=bold];
  Listing_id [shape=ellipse,label=<<U>id</U>>];
  Listing -- Listing_id [len=.85];
  Listing_title [shape=ellipse,label=<title>];
  Listing -- Listing_title [len=.85];
  Listing_price [shape=ellipse,label=<price>];
  Listing -- Listing_price [len=.85];
  Listing_condition [shape=ellipse,label=<condition>];
  Listing -- Listing_condition [len=.85];
  Listing_state [shape=ellipse,label=<state>];
  Listing -- Listing_state [len=.85];
  Category [shape=box,style=bold];
  Category_id [shape=ellipse,label=<<U>id</U>>];
  Category -- Category_id [len=.85];
  Category_name [shape=ellipse,label=<name>];
  Category -- Category_name [len=.85];
  Category_active [shape=ellipse,label=<active>];
  Category -- Category_active [len=.85];
  Asset [shape=box,style=bold];
  Asset_id [shape=ellipse,label=<<U>id</U>>];
  Asset -- Asset_id [len=.85];
  Asset_purpose [shape=ellipse,label=<purpose>];
  Asset -- Asset_purpose [len=.85];
  Asset_objectKey [shape=ellipse,label=<objectKey>];
  Asset -- Asset_objectKey [len=.85];
  rel0_0 [shape=diamond,label="Có sinh viên"];
  School -- rel0_0 [taillabel="1"];
  rel0_0 -- User [headlabel="N"];
  rel0_1 [shape=diamond,label="Nơi đăng"];
  School -- rel0_1 [taillabel="1"];
  rel0_1 -- Listing [headlabel="N"];
  rel0_2 [shape=diamond,label="Đăng bán"];
  User -- rel0_2 [taillabel="1"];
  rel0_2 -- Listing [headlabel="N"];
  rel0_3 [shape=diamond,label="Phân loại"];
  Category -- rel0_3 [taillabel="1"];
  rel0_3 -- Listing [headlabel="N"];
  rel0_4 [shape=diamond,label="Có ảnh"];
  Listing -- rel0_4 [taillabel="1"];
  rel0_4 -- Asset [headlabel="N"];
  rel0_5 [shape=diamond,label="Tải lên"];
  User -- rel0_5 [taillabel="1"];
  rel0_5 -- Asset [headlabel="N"];
  rel0_6 [shape=diamond,label="Lưu tin"];
  User -- rel0_6 [taillabel="M"];
  rel0_6 -- Listing [headlabel="N"];
  rel0_7 [shape=diamond,label="Theo dõi danh mục"];
  User -- rel0_7 [taillabel="M"];
  rel0_7 -- Category [headlabel="N"];
  rel0_8 [shape=diamond,label="Theo dõi người bán"];
  User -- rel0_8 [taillabel="M · theo dõi"];
  rel0_8 -- User [headlabel="N · được theo dõi"];
  Reservation [shape=box,style=bold];
  Reservation_id [shape=ellipse,label=<<U>id</U>>];
  Reservation -- Reservation_id [len=.85];
  Reservation_state [shape=ellipse,label=<state>];
  Reservation -- Reservation_state [len=.85];
  Reservation_finalPrice [shape=ellipse,label=<finalPrice>];
  Reservation -- Reservation_finalPrice [len=.85];
  Reservation_meetingAt [shape=ellipse,label=<meetingAt>];
  Reservation -- Reservation_meetingAt [len=.85];
  Reservation_meetingPlace [shape=ellipse,label=<meetingPlace>];
  Reservation -- Reservation_meetingPlace [len=.85];
  Review [shape=box,style=bold];
  Review_id [shape=ellipse,label=<<U>id</U>>];
  Review -- Review_id [len=.85];
  Review_rating [shape=ellipse,label=<rating>];
  Review -- Review_rating [len=.85];
  Review_comment [shape=ellipse,label=<comment>];
  Review -- Review_comment [len=.85];
  Conversation [shape=box,style=bold];
  Conversation_id [shape=ellipse,label=<<U>id</U>>];
  Conversation -- Conversation_id [len=.85];
  Conversation_createdAt [shape=ellipse,label=<createdAt>];
  Conversation -- Conversation_createdAt [len=.85];
  Message [shape=box,style=bold];
  Message_id [shape=ellipse,label=<<U>id</U>>];
  Message -- Message_id [len=.85];
  Message_text [shape=ellipse,label=<text>];
  Message -- Message_text [len=.85];
  Message_createdAt [shape=ellipse,label=<createdAt>];
  Message -- Message_createdAt [len=.85];
  rel1_0 [shape=diamond,label="Hỏi mua"];
  User -- rel1_0 [taillabel="1"];
  rel1_0 -- Conversation [headlabel="N"];
  rel1_1 [shape=diamond,label="Được hỏi về"];
  Listing -- rel1_1 [taillabel="1"];
  rel1_1 -- Conversation [headlabel="N"];
  rel1_2 [shape=diamond,label="Chứa"];
  Conversation -- rel1_2 [taillabel="1"];
  rel1_2 -- Message [headlabel="N"];
  rel1_3 [shape=diamond,label="Gửi"];
  User -- rel1_3 [taillabel="1"];
  rel1_3 -- Message [headlabel="N"];
  rel1_4 [shape=diamond,label="Yêu cầu giữ"];
  User -- rel1_4 [taillabel="1"];
  rel1_4 -- Reservation [headlabel="N"];
  rel1_5 [shape=diamond,label="Nhận yêu cầu"];
  Listing -- rel1_5 [taillabel="1"];
  rel1_5 -- Reservation [headlabel="N"];
  rel1_6 [shape=diamond,label="Cho phép"];
  Reservation -- rel1_6 [taillabel="1"];
  rel1_6 -- Review [headlabel="N"];
  rel1_7 [shape=diamond,label="Viết"];
  User -- rel1_7 [taillabel="1"];
  rel1_7 -- Review [headlabel="N"];
  rel1_8 [shape=diamond,label="Được chấm"];
  User -- rel1_8 [taillabel="1"];
  rel1_8 -- Review [headlabel="N"];
  User_role [shape=ellipse,label=<role>];
  User -- User_role [len=.85];
  User_status [shape=ellipse,label=<status>];
  User -- User_status [len=.85];
  Report [shape=box,style=bold];
  Report_id [shape=ellipse,label=<<U>id</U>>];
  Report -- Report_id [len=.85];
  Report_reason [shape=ellipse,label=<reason>];
  Report -- Report_reason [len=.85];
  Report_state [shape=ellipse,label=<state>];
  Report -- Report_state [len=.85];
  Notification [shape=box,style=bold];
  Notification_id [shape=ellipse,label=<<U>id</U>>];
  Notification -- Notification_id [len=.85];
  Notification_kind [shape=ellipse,label=<kind>];
  Notification -- Notification_kind [len=.85];
  Notification_readAt [shape=ellipse,label=<readAt>];
  Notification -- Notification_readAt [len=.85];
  Session [shape=box,style=bold];
  Session_id [shape=ellipse,label=<<U>id</U>>];
  Session -- Session_id [len=.85];
  Session_expiresAt [shape=ellipse,label=<expiresAt>];
  Session -- Session_expiresAt [len=.85];
  Session_revokedAt [shape=ellipse,label=<revokedAt>];
  Session -- Session_revokedAt [len=.85];
  VerificationToken [shape=box,style=bold];
  VerificationToken_id [shape=ellipse,label=<<U>id</U>>];
  VerificationToken -- VerificationToken_id [len=.85];
  VerificationToken_expiresAt [shape=ellipse,label=<expiresAt>];
  VerificationToken -- VerificationToken_expiresAt [len=.85];
  VerificationToken_tokenHash [shape=ellipse,label=<tokenHash>];
  VerificationToken -- VerificationToken_tokenHash [len=.85];
  ModerationLog [shape=box,style=bold];
  ModerationLog_id [shape=ellipse,label=<<U>id</U>>];
  ModerationLog -- ModerationLog_id [len=.85];
  ModerationLog_action [shape=ellipse,label=<action>];
  ModerationLog -- ModerationLog_action [len=.85];
  ModerationLog_reason [shape=ellipse,label=<reason>];
  ModerationLog -- ModerationLog_reason [len=.85];
  rel2_0 [shape=diamond,label="Gửi báo cáo"];
  User -- rel2_0 [taillabel="1"];
  rel2_0 -- Report [headlabel="N"];
  rel2_1 [shape=diamond,label="Bị báo cáo"];
  Listing -- rel2_1 [taillabel="1"];
  rel2_1 -- Report [headlabel="N"];
  rel2_2 [shape=diamond,label="Xử lý báo cáo"];
  User -- rel2_2 [taillabel="1"];
  rel2_2 -- Report [headlabel="N"];
  rel2_3 [shape=diamond,label="Nhận"];
  User -- rel2_3 [taillabel="1"];
  rel2_3 -- Notification [headlabel="N"];
  rel2_4 [shape=diamond,label="Có phiên"];
  User -- rel2_4 [taillabel="1"];
  rel2_4 -- Session [headlabel="N"];
  rel2_5 [shape=diamond,label="Xác thực qua"];
  User -- rel2_5 [taillabel="1"];
  rel2_5 -- VerificationToken [headlabel="N"];
  rel2_6 [shape=diamond,label="Ghi quyết định"];
  User -- rel2_6 [taillabel="1"];
  rel2_6 -- ModerationLog [headlabel="N"];
  usesQr [shape=diamond,label="Dùng QR"];
  Reservation -- usesQr [taillabel="N"];
  usesQr -- Asset [headlabel="1"];
}
